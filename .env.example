# ============================================================
# NyaySetu AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file — it's in .gitignore.
# ============================================================

# --- Google Gemini API ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase ---
# Find these in your Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Backend ---
# The port FastAPI will run on locally
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Secret key for signing tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_random_secret_key_here

# --- Frontend (Vite exposes VITE_ prefixed vars to the browser) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_BASE_URL=http://localhost:8000

# --- Rate Limiting ---
# Requests per minute per IP for each endpoint group
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_ANALYSIS=20/hour
RATE_LIMIT_CHAT=60/hour
RATE_LIMIT_COMPARISON=5/hour
