# ===========================
# NyaySetu AI — .gitignore
# ===========================

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend ---
node_modules/
.pnp
.pnp.js
frontend/dist/
frontend/build/
frontend/.vite/

# --- Environment Variables (NEVER COMMIT) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# --- Uploaded Documents (privacy / size) ---
*.pdf
*.docx
*.doc
*.odt
uploads/
temp_uploads/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing ---
coverage/
.nyc_output/

# --- Misc ---
*.bak
*.tmp
